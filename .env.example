# Discovery-service
EUREKA=http://localhost:8761/eureka/

# MYSQL
MYSQL_USERNAME=root
MYSQL_PASSWORD=<password>

# Idenity-sevice
IDENTITY_URL=jdbc:mysql://localhost:3306/identity_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SIGNER_KEY=<signer-key>
VALID_DURATION=<valid-duration>
REFRESHABLE_DURATION=<refreshable-duration>

# Login google
CLIENT_ID=<client-id>
CLIENT_SECRET=<client-secret>
REDIRECT_URL=<redirect=-url>

# Profile-service
PROFILE_URL=jdbc:mysql://localhost:3306/profile_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Product-serice
PRODUCT_URL=jdbc:mysql://localhost:3306/food_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Search-service
ELASTIC_SEARCH=https://localhost:9200
USERNAME=elastic
PASSWORD=<elastic-password>
# phần này dành cho từng đối tượng thực thi chương trình.
# đường dẫn này tùy thuộc vào việc bạn dùng windown hay linux sẽ có đường dẫn ssl khác nhau
SSL=<ssl>

# Notification-service
API_KEY_BREVO=<api-key-brevo>
NOTIFICATION_SERVICE_DB=mongodb://root:<mongo-password>@localhost:27017/notification-service?authSource=admin

# Payment-service
PAYOS_CLIENT_ID=<payos-client-id>
PAYOS_API_KEY=<payos-api-key>
PAYOS_CHECKSUM_KEY=<checksum-key>
PAYMENT_URL=jdbc:mysql://localhost:3306/payment_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Cart-service
CART_URL=jdbc:mysql://localhost:3306/cart_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Order-service
ORDER_URL=jdbc:mysql://localhost:3306/order_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# File-service
FILE_URL=mongodb://root:<mongodb-password>@localhost:27017/file_db?authSource=admin

# Post-service
POST_DB=mongodb://root:<mongodb-password>@localhost:27017/post_db?authSource=admin

# Frontend
# API Gateway (prefix /api/v1 khai báo trong api-gateway/application.yaml)
VITE_API_BASE_URL=http://localhost:8888/api/v1

# Tuỳ chọn: đăng nhập Google (identity-service /auth/outbound/identity)
# redirect uri phải trùng với outbound.identity.redirect-uri của identity-service
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/authenticate