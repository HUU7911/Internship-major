# Copy this file to .env before running: cp .env.docker.example .env
# Development defaults only. Replace all secrets before any public deployment.

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=123456

# JWT (use a strong random secret in deployment)
SIGNER_KEY=change-this-development-jwt-key-before-deploying-1234567890
VALID_DURATION=3600
REFRESHABLE_DURATION=604800

# Google OAuth (optional for local startup; fill in to enable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/authenticate

# Brevo email (optional until notification email is used)
API_KEY_BREVO=

# PayOS (optional until online payment is used)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# Elasticsearch development password placeholder.
# Elasticsearch security is disabled in this local Compose configuration.
ELASTIC_PASSWORD=123456

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=12345678
MINIO_BUCKET=shop-meal

# Frontend build-time settings
VITE_API_BASE_URL=http://localhost:8888/api/v1
VITE_SOCKET_URL=http://localhost:8099
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/authenticate

# Kafka external advertised hostname. Use localhost for clients on this machine.
KAFKA_EXTERNAL_HOST=localhost
